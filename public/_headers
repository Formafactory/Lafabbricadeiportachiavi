# Intestazioni di sicurezza e cache (stesso schema di bomboniere3dart.it).
# Passo 1: pagina statica, nessuna risorsa esterna (font inclusi nel sito).
# Dal passo 2 si aggiungono Turnstile (challenges.cloudflare.com) in script-src/frame-src.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# File con hash nel nome: immutabili
/assets/*
  Cache-Control: public, max-age=31536000, immutable
